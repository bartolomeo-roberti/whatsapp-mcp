+// deviceName is the name WhatsApp lists for this linked companion device.
+const deviceName = "Cerase"
+
+// configureDeviceIdentity makes the bridge register as a desktop companion
+// named deviceName instead of whatsmeow's defaults. Every other DeviceProps
+// field, including HistorySyncConfig, is left as whatsmeow set it.
+func configureDeviceIdentity() {
+	store.DeviceProps.Os = proto.String(deviceName)
+	store.DeviceProps.PlatformType = waCompanionReg.DeviceProps_DESKTOP.Enum()
+}
+
 func main() {
+	configureDeviceIdentity()

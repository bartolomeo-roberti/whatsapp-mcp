+package main
+
+import (
+	"testing"
+
+	waCompanionReg "go.mau.fi/whatsmeow/proto/waCompanionReg"
+	"go.mau.fi/whatsmeow/store"
+)
+
+func TestConfigureDeviceIdentity(t *testing.T) {
+	configureDeviceIdentity()
+
+	if got := store.DeviceProps.GetOs(); got != deviceName {
+		t.Fatalf("DeviceProps.Os = %q, want %q", got, deviceName)
+	}
+	if got := store.DeviceProps.GetPlatformType(); got != waCompanionReg.DeviceProps_DESKTOP {
+		t.Fatalf("DeviceProps.PlatformType = %v, want DESKTOP", got)
+	}
+	if store.DeviceProps.HistorySyncConfig == nil {
+		t.Fatal("DeviceProps.HistorySyncConfig is nil")
+	}
+}

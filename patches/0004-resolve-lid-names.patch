+func TestRefreshDirectChatNamesUpgradesAddressBook(t *testing.T) {
+	ctx := context.Background()
+	client := newTestClient(t)
+	messageStore := newTestMessageStore(t)
+
+	lidJID := types.NewJID("100000000000012", types.HiddenUserServer)
+	phoneJID := types.NewJID("10000000012", types.DefaultUserServer)
+	if err := client.Store.LIDs.PutLIDMapping(ctx, lidJID, phoneJID); err != nil {
+		t.Fatalf("put LID mapping: %v", err)
+	}
+	if _, _, err := client.Store.Contacts.PutPushName(ctx, lidJID, "Ali"); err != nil {
+		t.Fatalf("put LID push name: %v", err)
+	}
+	if err := client.Store.Contacts.PutContactName(ctx, phoneJID, "", "Alice Example"); err != nil {
+		t.Fatalf("put phone contact name: %v", err)
+	}
+	if _, _, err := client.Store.Contacts.PutPushName(ctx, phoneJID, "Ali"); err != nil {
+		t.Fatalf("put phone push name: %v", err)
+	}
+
+	if err := messageStore.StoreChat(lidJID.String(), "Ali", time.Now()); err != nil {
+		t.Fatalf("store LID chat: %v", err)
+	}
+	if err := messageStore.StoreChat(phoneJID.String(), "Alice Example", time.Now()); err != nil {
+		t.Fatalf("store phone chat: %v", err)
+	}
+
+	refreshDirectChatNames(ctx, client, messageStore, waLog.Noop)
+
+	if got := messageStore.storedChatName(lidJID); got != "Alice Example" {
+		t.Errorf("LID chat name = %q, want %q", got, "Alice Example")
+	}
+	if got := messageStore.storedChatName(phoneJID); got != "Alice Example" {
+		t.Errorf("phone chat name = %q, want %q", got, "Alice Example")
+	}
+}

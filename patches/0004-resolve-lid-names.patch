+// isDigitsOnly reports whether s consists only of ASCII digits.
+func isDigitsOnly(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// isUsableChatName reports whether s can be shown as a person's name: it must
+// be non-empty and must not be only digits (a bare phone or LID number).
+func isUsableChatName(s string) bool {
+	s = strings.TrimSpace(s)
+	return s != "" && !isDigitsOnly(s)
+}
+
+// Contact name priority: lower is better. A name from the address book (full,
+// first or business) always beats the push name a person chose for themselves.
+const (
+	nameLevelFull = iota
+	nameLevelFirst
+	nameLevelBusiness
+	nameLevelPush
+	nameLevelUnknown
+)
+
+// contactNameAt returns the usable name at one priority level from a cached
+// contact entry.
+func contactNameAt(contact types.ContactInfo, level int) string {
+	var candidate string
+	switch level {
+	case nameLevelFull:
+		candidate = contact.FullName
+	case nameLevelFirst:
+		candidate = contact.FirstName
+	case nameLevelBusiness:
+		candidate = contact.BusinessName
+	case nameLevelPush:
+		candidate = contact.PushName
+	default:
+		return ""
+	}
+	if !isUsableChatName(candidate) {
+		return ""
+	}
+	return strings.TrimSpace(candidate)
+}
+
+// storedChatName returns the usable name stored for jid in the chats table.
+func (store *MessageStore) storedChatName(jid types.JID) string {
+	var name string
+	if err := store.db.QueryRow("SELECT name FROM chats WHERE jid = ?", jid.String()).Scan(&name); err != nil {
+		return ""
+	}
+	if !isUsableChatName(name) {
+		return ""
+	}
+	return strings.TrimSpace(name)
+}
+
+// directIdentities returns the identities of a direct chat: its own JID first,
+// then the mapped phone or LID JID. Groups and other servers have none.
+func directIdentities(ctx context.Context, client *whatsmeow.Client, jid types.JID) []types.JID {
+	if jid.Server != types.DefaultUserServer && jid.Server != types.HiddenUserServer {
+		return nil
+	}
+
+	jids := []types.JID{jid}
+	if jid.Server == types.HiddenUserServer {
+		if pn, err := client.Store.LIDs.GetPNForLID(ctx, jid); err == nil && !pn.IsEmpty() {
+			jids = append(jids, pn)
+		}
+	} else if lid, err := client.Store.LIDs.GetLIDForPN(ctx, jid); err == nil && !lid.IsEmpty() {
+		jids = append(jids, lid)
+	}
+	return jids
+}
+
+// addressBookName returns the best usable address-book name for a direct chat:
+// a full name, then a first name, then a business name, over both identities.
+func addressBookName(ctx context.Context, client *whatsmeow.Client, jid types.JID) (string, int) {
+	jids := directIdentities(ctx, client, jid)
+	for _, level := range []int{nameLevelFull, nameLevelFirst, nameLevelBusiness} {
+		for _, candidate := range jids {
+			contact, err := client.Store.Contacts.GetContact(ctx, candidate)
+			if err != nil {
+				continue
+			}
+			if name := contactNameAt(contact, level); name != "" {
+				return name, level
+			}
+		}
+	}
+	return "", nameLevelUnknown
+}
+
+// addressBookLevel returns the priority of a stored name when it is also an
+// address-book name of one of the chat's identities, or nameLevelUnknown.
+func addressBookLevel(ctx context.Context, client *whatsmeow.Client, jid types.JID, name string) int {
+	jids := directIdentities(ctx, client, jid)
+	for _, level := range []int{nameLevelFull, nameLevelFirst, nameLevelBusiness} {
+		for _, candidate := range jids {
+			contact, err := client.Store.Contacts.GetContact(ctx, candidate)
+			if err != nil {
+				continue
+			}
+			if contactNameAt(contact, level) == name {
+				return level
+			}
+		}
+	}
+	return nameLevelUnknown
+}
+
+// betterAddressBookName reports the address-book name that should replace the
+// stored one. It only suggests a name that is higher priority, so a stored full
+// name is never replaced by a first or business name.
+func betterAddressBookName(ctx context.Context, client *whatsmeow.Client, jid types.JID, stored string) (string, bool) {
+	best, bestLevel := addressBookName(ctx, client, jid)
+	if best == "" || best == stored {
+		return "", false
+	}
+	storedLevel := addressBookLevel(ctx, client, jid, stored)
+	if storedLevel != nameLevelUnknown && bestLevel > storedLevel {
+		return "", false
+	}
+	return best, true
+}
+
+// resolveDirectName finds the best human name for a direct chat. A LID chat's
+// contact is usually stored under the matching phone JID (and the reverse can
+// happen too), so both identities are consulted. Address-book names come first
+// (full, first, business), then the push name, then the names already stored
+// for the chats.
+func resolveDirectName(ctx context.Context, client *whatsmeow.Client, messageStore *MessageStore, jid types.JID) string {
+	jids := directIdentities(ctx, client, jid)
+	for _, level := range []int{nameLevelFull, nameLevelFirst, nameLevelBusiness, nameLevelPush} {
+		for _, candidate := range jids {
+			contact, err := client.Store.Contacts.GetContact(ctx, candidate)
+			if err != nil {
+				continue
+			}
+			if name := contactNameAt(contact, level); name != "" {
+				return name
+			}
+		}
+	}
+	for _, candidate := range jids {
+		if name := messageStore.storedChatName(candidate); name != "" {
+			return name
+		}
+	}
+	return ""
+}
+
+// refreshDirectChatNames fills in names for direct chats whose stored name is
+// empty or only digits, and upgrades a stored push name to an address-book name
+// that is now available. It only logs how many rows changed.
+func refreshDirectChatNames(ctx context.Context, client *whatsmeow.Client, messageStore *MessageStore, logger waLog.Logger) {
+	type chatRow struct {
+		jid  string
+		name string
+	}
+
+	rows, err := messageStore.db.Query("SELECT jid, name FROM chats WHERE jid NOT LIKE '%@g.us'")
+	if err != nil {
+		logger.Warnf("Failed to read chats for name refresh")
+		return
+	}
+	var chats []chatRow
+	for rows.Next() {
+		var row chatRow
+		if err := rows.Scan(&row.jid, &row.name); err != nil {
+			continue
+		}
+		chats = append(chats, row)
+	}
+	if err := rows.Err(); err != nil {
+		logger.Warnf("Failed to read chats for name refresh")
+	}
+	rows.Close()
+
+	updated := 0
+	for _, row := range chats {
+		if strings.HasSuffix(row.jid, "@g.us") {
+			continue
+		}
+		jid, err := types.ParseJID(row.jid)
+		if err != nil {
+			continue
+		}
+		var name string
+		if !isUsableChatName(row.name) {
+			// No name yet: use the full resolution, which may end in a push
+			// name or the name of the mapped chat.
+			name = resolveDirectName(ctx, client, messageStore, jid)
+		} else {
+			best, ok := betterAddressBookName(ctx, client, jid, row.name)
+			if !ok {
+				continue
+			}
+			name = best
+		}
+		if name == "" || name == row.name {
+			continue
+		}
+		if _, err := messageStore.db.Exec("UPDATE chats SET name = ? WHERE jid = ?", name, row.jid); err != nil {
+			continue
+		}
+		updated++
+	}
+	if updated > 0 {
+		logger.Infof("updated %d chat names", updated)
+	}
+}

+package main
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waAdv"
+	"go.mau.fi/whatsmeow/store/sqlstore"
+	"go.mau.fi/whatsmeow/types"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+// newTestMessageStore creates the message database used by the bridge, in a
+// temporary directory.
+func newTestMessageStore(t *testing.T) *MessageStore {
+	t.Helper()
+	db, err := sql.Open("sqlite3", "file:"+filepath.Join(t.TempDir(), "messages.db")+"?_foreign_keys=on")
+	if err != nil {
+		t.Fatalf("open message store: %v", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	_, err = db.Exec(`
+		CREATE TABLE IF NOT EXISTS chats (
+			jid TEXT PRIMARY KEY,
+			name TEXT,
+			last_message_time TIMESTAMP
+		);
+	`)
+	if err != nil {
+		t.Fatalf("create chats table: %v", err)
+	}
+	return &MessageStore{db: db}
+}
+
+// newTestClient creates a whatsmeow client backed by a temporary sqlite store.
+func newTestClient(t *testing.T) *whatsmeow.Client {
+	t.Helper()
+	ctx := context.Background()
+	container, err := sqlstore.New(ctx, "sqlite3",
+		"file:"+filepath.Join(t.TempDir(), "whatsapp.db")+"?_foreign_keys=on", waLog.Noop)
+	if err != nil {
+		t.Fatalf("open whatsmeow store: %v", err)
+	}
+	t.Cleanup(func() { _ = container.Close() })
+
+	device := container.NewDevice()
+	device.ID = &types.JID{User: "99999999999", Server: types.DefaultUserServer}
+	device.Account = &waAdv.ADVSignedDeviceIdentity{
+		Details:             []byte{},
+		AccountSignature:    make([]byte, 64),
+		AccountSignatureKey: make([]byte, 32),
+		DeviceSignature:     make([]byte, 64),
+	}
+	if err := container.PutDevice(ctx, device); err != nil {
+		t.Fatalf("save device: %v", err)
+	}
+	return whatsmeow.NewClient(device, waLog.Noop)
+}
+
+func TestResolveDirectName(t *testing.T) {
+	ctx := context.Background()
+	client := newTestClient(t)
+	messageStore := newTestMessageStore(t)
+
+	lidJID := types.NewJID("100000000000001", types.HiddenUserServer)
+	phoneJID := types.NewJID("10000000001", types.DefaultUserServer)
+	if err := client.Store.LIDs.PutLIDMapping(ctx, lidJID, phoneJID); err != nil {
+		t.Fatalf("put LID mapping: %v", err)
+	}
+	if err := client.Store.Contacts.PutContactName(ctx, phoneJID, "Alice", "Alice Example"); err != nil {
+		t.Fatalf("put contact name: %v", err)
+	}
+
+	if got := resolveDirectName(ctx, client, messageStore, lidJID); got != "Alice Example" {
+		t.Errorf("LID name = %q, want %q", got, "Alice Example")
+	}
+	if got := resolveDirectName(ctx, client, messageStore, phoneJID); got != "Alice Example" {
+		t.Errorf("phone name = %q, want %q", got, "Alice Example")
+	}
+
+	unknownLID := types.NewJID("100000000000099", types.HiddenUserServer)
+	if got := resolveDirectName(ctx, client, messageStore, unknownLID); got != "" {
+		t.Errorf("unknown LID name = %q, want empty", got)
+	}
+
+	digitsPN := types.NewJID("10000000002", types.DefaultUserServer)
+	if _, _, err := client.Store.Contacts.PutPushName(ctx, digitsPN, "10000000002"); err != nil {
+		t.Fatalf("put push name: %v", err)
+	}
+	if got := resolveDirectName(ctx, client, messageStore, digitsPN); got != "" {
+		t.Errorf("digits-only push name = %q, want empty", got)
+	}
+
+	// A named phone-JID chat names its LID chat when the contact store has no
+	// entry for either.
+	chatLID := types.NewJID("100000000000003", types.HiddenUserServer)
+	chatPN := types.NewJID("10000000003", types.DefaultUserServer)
+	if err := client.Store.LIDs.PutLIDMapping(ctx, chatLID, chatPN); err != nil {
+		t.Fatalf("put LID mapping: %v", err)
+	}
+	if err := messageStore.StoreChat(chatPN.String(), "Bob Example", time.Now()); err != nil {
+		t.Fatalf("store chat: %v", err)
+	}
+	if got := resolveDirectName(ctx, client, messageStore, chatLID); got != "Bob Example" {
+		t.Errorf("LID name from phone chat row = %q, want %q", got, "Bob Example")
+	}
+
+	// And the reverse: an unnamed phone-JID chat takes the name of its mapped
+	// LID chat.
+	revPN := types.NewJID("10000000004", types.DefaultUserServer)
+	revLID := types.NewJID("100000000000004", types.HiddenUserServer)
+	if err := client.Store.LIDs.PutLIDMapping(ctx, revLID, revPN); err != nil {
+		t.Fatalf("put LID mapping: %v", err)
+	}
+	if err := messageStore.StoreChat(revLID.String(), "Carol Example", time.Now()); err != nil {
+		t.Fatalf("store chat: %v", err)
+	}
+	if got := resolveDirectName(ctx, client, messageStore, revPN); got != "Carol Example" {
+		t.Errorf("phone name from LID chat row = %q, want %q", got, "Carol Example")
+	}
+}
+
+func TestIsDigitsOnly(t *testing.T) {
+	tests := []struct {
+		name string
+		in   string
+		want bool
+	}{
+		{"empty", "", false},
+		{"digits", "10000000001", true},
+		{"zeros", "000", true},
+		{"letter", "1000000000a", false},
+		{"space", "100 000", false},
+		{"name", "Alice", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := isDigitsOnly(tt.in); got != tt.want {
+				t.Errorf("isDigitsOnly(%q) = %v, want %v", tt.in, got, tt.want)
+			}
+		})
+	}
+}

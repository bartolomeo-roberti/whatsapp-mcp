{
  "schema_version": 2,
  "namespace": "reale.errante",
  "name": "whatsapp",
  "type": "connector",
  "display_name": "WhatsApp - Personal use",
  "description": "A community package built on lharries/whatsapp-mcp. Each person links their own WhatsApp number by scanning a QR code; automating a personal account is outside WhatsApp's terms and can get the number blocked.",
  "license": "MIT",
  "tags": [
    "whatsapp",
    "messaging",
    "social"
  ],
  "install": {
    "image": "ghcr.io/bartolomeo-roberti/whatsapp-mcp@sha256:f8c80fcc66db74b530a87ba7cc28a54ddc9bb106455a0b6ebd31e81f6111418e",
    "state": {
      "path": "/home/pwuser/.whatsapp-mcp",
      "max_mb": 500
    },
    "memory_mb": 512
  },
  "hosts": [
    "whatsapp.com",
    "*.whatsapp.com",
    "*.whatsapp.net"
  ],
  "auth": {
    "kind": "browser",
    "credential_scope": "user",
    "login": {
      "args": [
        "--login"
      ]
    }
  },
  "tool_side_effects": {
    "default": "workspace_write",
    "read_only": [
      "search_contacts",
      "list_messages",
      "list_chats",
      "get_chat",
      "get_direct_chat_by_contact",
      "get_contact_chats",
      "get_last_interaction",
      "get_message_context"
    ]
  }
}
